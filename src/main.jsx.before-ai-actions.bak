import React,{useEffect,useMemo,useState} from 'react';import{createRoot}from'react-dom/client';import{LayoutDashboard,Wallet,ArrowUpRight,ArrowDownLeft,PiggyBank,Sparkles,Settings,Plus,ChevronRight,TrendingUp,ShieldCheck,Download,Upload,Sun,Moon,CheckCircle2,AlertCircle,X,Send,Trash2,CalendarDays,Landmark,HelpCircle,RefreshCcw}from'lucide-react';import{ResponsiveContainer,AreaChart,Area,CartesianGrid,XAxis,Tooltip,BarChart,Bar,Legend}from'recharts';import{KEY,pesos,cents,load,save,addIncome,addExpense,transfer,stats,daily,offlineAdvice,retrieval,validate,today}from'./finance';import './style.css';
const nav=[['home','Overview',LayoutDashboard],['activity','Activity',Wallet],['savings','Savings',PiggyBank],['coach','AI Coach',Sparkles],['settings','Settings',Settings]];const bucketInfo={needs:{title:'Needs',sub:'Essentials & school',color:'mint',icon:'🚌'},wants:{title:'Wants',sub:'Treats & extras',color:'peach',icon:'✨'},savings:{title:'Savings',sub:'Your future fund',color:'lavender',icon:'🌱'}};
function App(){const[state,setState]=useState(load),[tab,setTab]=useState('home'),[modal,setModal]=useState(''),[toast,setToast]=useState(''),[chat,setChat]=useState([]),[question,setQuestion]=useState(''),[thinking,setThinking]=useState(false),[online,setOnline]=useState(navigator.onLine),[install,setInstall]=useState(null),[filter,setFilter]=useState('all');const summary=useMemo(()=>stats(state.entries),[state]),b=summary.balance,series=useMemo(()=>daily(state.entries),[state]);useEffect(()=>{save(state)},[state]);useEffect(()=>{const on=()=>setOnline(navigator.onLine),before=e=>{e.preventDefault();setInstall(e)};window.addEventListener('online',on);window.addEventListener('offline',on);window.addEventListener('beforeinstallprompt',before);return()=>{window.removeEventListener('online',on);window.removeEventListener('offline',on);window.removeEventListener('beforeinstallprompt',before)}},[]);useEffect(()=>{document.documentElement.dataset.theme=state.settings.theme||'light'},[state.settings.theme]);function notify(msg){setToast(msg);setTimeout(()=>setToast(''),3500)}function commit(fn,success){try{setState(prev=>fn(prev));setModal('');notify(success)}catch(e){notify(e.message)}}function submitIncome(amount,label){commit(s=>addIncome(s,amount,label),'Allowance allocated successfully')}function submitExpense(amount,bucket,label){commit(s=>addExpense(s,amount,bucket,label),'Expense recorded')}function submitTransfer(amount,provider,note){commit(s=>transfer(s,amount,provider,note),'Transfer marked as completed')}async function ask(text){if(!text.trim()||thinking)return;setQuestion('');setChat(v=>[...v,{role:'user',text}]);setThinking(true);let answer;try{if(!navigator.onLine)throw Error('offline');const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),12000);try{const r=await fetch('/api/coach',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:text,context:retrieval(state,text)}),signal:controller.signal});if(!r.ok)throw Error('AI not configured');const data=await r.json();answer=data.answer;if(typeof answer!=='string')throw Error('No response')}finally{clearTimeout(timer)}}catch{answer=offlineAdvice(state,text)+'\n\n(Offline guidance — no cloud AI used.)'}setChat(v=>[...v,{role:'assistant',text:answer}]);setThinking(false)}async function importFile(file){try{if(!file)return;const text=await file.text();if(text.length>8_000_000)throw Error('Backup too large');const parsed=JSON.parse(text);if(!validate(parsed))throw Error('Invalid Pocketwise backup');if(!window.confirm('Replace all current data with this backup?'))return;setState(parsed);notify('Backup restored')}catch(e){notify(e.message)}}function exportFile(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`pocketwise-backup-${today()}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}const total=b.needs+b.wants+b.savings;const spentBy={needs:state.entries.filter(e=>e.type==='expense'&&e.bucket==='needs').reduce((s,e)=>s+e.amount,0),wants:state.entries.filter(e=>e.type==='expense'&&e.bucket==='wants').reduce((s,e)=>s+e.amount,0)};const activity=[...state.entries].reverse().filter(e=>['income','expense','transfer'].includes(e.type)&& (filter==='all'||e.type===filter));return <div className="shell"><aside className="sidebar"><div className="brand"><div className="brand-mark">₱</div><span>Pocketwise<small>50 / 30 / 20</small></span></div><div className="side-label">YOUR SPACE</div><nav>{nav.map(([id,name,Icon])=><button key={id} className={'nav-item '+(tab===id?'active':'')} onClick={()=>setTab(id)}><Icon size={19}/>{name}{id==='coach'&&<span className="new-dot"/>}</button>)}</nav><div className="side-bottom"><div className="tip-illustration">🌿</div><strong>Little steps, big wins.</strong><p>Build a better money habit, one allowance at a time.</p></div></aside><main className="main"><header className="topbar"><div className="crumb">PERSONAL FINANCE <ChevronRight size={14}/> <strong>{nav.find(x=>x[0]===tab)?.[1]}</strong></div><div className="top-actions"><span className={'connect '+(online?'':'off')}><i/>{online?'Online':'Offline ready'}</span><button className="icon-button" aria-label="Toggle theme" onClick={()=>setState(s=>({...s,settings:{...s.settings,theme:s.settings.theme==='dark'?'light':'dark'}}))}>{state.settings.theme==='dark'?<Sun size={19}/>:<Moon size={19}/>}</button><div className="avatar">P</div></div></header><div className="content">{tab==='home'&&<><div className="heading-row"><div><div className="eyebrow">YOUR MONEY, MADE SIMPLE</div><h1>Make every peso count<span className="wave"> ✳</span></h1><p className="muted">A little planning today goes a long way tomorrow.</p></div><button className="primary desktop-add" onClick={()=>setModal('income')}><Plus size={18}/> Add allowance</button></div><div className="hero"><div className="hero-content"><div className="hero-tag"><span>✦</span> YOUR TOTAL AVAILABLE</div><div className="hero-money">{pesos(total)}</div><div className="hero-foot">Across your three money envelopes</div><button className="hero-btn" onClick={()=>setModal('income')}><Plus size={18}/> Add money <ArrowUpRight size={17}/></button></div><div className="hero-art" aria-hidden="true"><div className="art-ring ring-one"/><div className="art-ring ring-two"/><div className="art-wallet">₱<span>✦</span></div><div className="art-coin coin-one">₱</div><div className="art-coin coin-two">✳</div></div></div><div className="section-line"><div><h2>Your money buckets</h2><p>Every peso has a purpose</p></div><span className="pill">50 / 30 / 20 RULE</span></div><div className="buckets">{['needs','wants','savings'].map((key,i)=>{const info=bucketInfo[key];return <div className={'bucket '+info.color} key={key}><div className="bucket-top"><span className="bucket-icon">{info.icon}</span><span className="percent">{[50,30,20][i]}%</span></div><h3>{info.title}</h3><p>{info.sub}</p><div className="bucket-money">{pesos(b[key])}</div><div className="bucket-track"><div style={{width:`${Math.max(0,Math.min(100,summary.income?b[key]/(summary.income*[.5,.3,.2][i])*100:0))}%`}}/></div><button className="bucket-link" onClick={()=>key==='savings'?setTab('savings'):setModal(key)}> {key==='savings'?'View savings':'Log expense'} <ArrowUpRight size={16}/></button></div>})}</div><div className="two-col"><section className="panel chart-panel"><div className="panel-heading"><div><h2>Money in & out</h2><p>Last 7 days at a glance</p></div><span className="mini-pill"><CalendarDays size={14}/> 7 days</span></div><div className="chart-area"><ResponsiveContainer width="100%" height="100%"><BarChart data={series} barGap={5}><CartesianGrid vertical={false} stroke="var(--grid)" strokeDasharray="3 4"/><XAxis dataKey="label" tickLine={false} axisLine={false} tick={{fill:'var(--muted)',fontSize:11}}/><Tooltip formatter={v=>`₱${v.toFixed(2)}`} contentStyle={{borderRadius:12,border:'1px solid #ddd'}}/><Legend iconType="circle" wrapperStyle={{fontSize:12}}/><Bar dataKey="income" name="Income" fill="#73bd9b" radius={[5,5,0,0]}/><Bar dataKey="spend" name="Spent" fill="#f4b487" radius={[5,5,0,0]}/></BarChart></ResponsiveContainer></div></section><section className="panel recent"><div className="panel-heading"><div><h2>Recent activity</h2><p>Your latest money moves</p></div><button className="text-link" onClick={()=>setTab('activity')}>See all <ArrowUpRight size={15}/></button></div>{activity.length?activity.slice(0,4).map(e=><ActivityItem key={e.id} e={e}/>):<div className="empty-mini"><span>🧾</span><strong>Nothing here yet</strong><p>Add your first allowance to get started.</p></div>}</section></div><div className="insight"><div className="insight-icon"><Sparkles size={21}/></div><div><strong>A little money wisdom</strong><p>{offlineAdvice(state,'summary')}</p></div><button onClick={()=>setTab('coach')}>Ask coach <ChevronRight size={16}/></button></div></>}{tab==='activity'&&<><div className="heading-row"><div><div className="eyebrow">EVERY PESO, ACCOUNTED FOR</div><h1>Activity</h1><p className="muted">Your money story, one entry at a time.</p></div><button className="primary" onClick={()=>setModal('income')}><Plus size={17}/> Add allowance</button></div><div className="metrics"><div><span>Total income</span><strong>{pesos(summary.income)}</strong><ArrowDownLeft size={20}/></div><div><span>Total expenses</span><strong>{pesos(summary.expenses)}</strong><ArrowUpRight size={20}/></div><div><span>Moved to savings</span><strong>{pesos(summary.transfers)}</strong><Landmark size={20}/></div></div><div className="panel activity-panel"><div className="panel-heading"><div><h2>Transaction history</h2><p>Allowance, purchases and transfers</p></div><button className="secondary" onClick={()=>setModal('expense')}><Plus size={16}/> Expense</button></div><div className="filters">{['all','income','expense','transfer'].map(v=><button key={v} className={filter===v?'selected':''} onClick={()=>setFilter(v)}>{v==='all'?'All activity':v==='income'?'Income':v==='expense'?'Expenses':'Transfers'}</button>)}</div>{activity.length?activity.map(e=><ActivityItem key={e.id} e={e}/>):<div className="empty-mini"><span>📋</span><strong>No transactions found</strong><p>Try another filter or add an allowance.</p></div>}</div></>}{tab==='savings'&&<><div className="heading-row"><div><div className="eyebrow">GROW AT YOUR OWN PACE</div><h1>Your savings</h1><p className="muted">Set aside a little, build something meaningful.</p></div></div><div className="savings-hero"><div><div className="hero-tag">YOUR SAVINGS ENVELOPE</div><div className="hero-money">{pesos(b.savings)}</div><p>Available to move into your bank or e-wallet</p><button className="hero-btn" onClick={()=>setModal('transfer')}><Landmark size={17}/> Record a transfer</button></div><div className="savings-emoji">🌱</div></div><div className="two-col savings-grid"><div className="panel padded"><h2>How it works</h2><div className="step"><span>01</span><div><strong>Save automatically</strong><p>20% of each allocation is placed into Savings.</p></div></div><div className="step"><span>02</span><div><strong>Choose where it goes</strong><p>Record money you physically moved to a bank or e-wallet.</p></div></div><div className="step"><span>03</span><div><strong>Track your progress</strong><p>Your savings transfer history stays here for reference.</p></div></div></div><div className="panel padded"><h2>Savings summary</h2><div className="summary-row"><span>Still in envelope</span><strong>{pesos(b.savings)}</strong></div><div className="summary-row"><span>Transferred out</span><strong>{pesos(summary.transfers)}</strong></div><div className="summary-row total"><span>Total saved / set aside</span><strong>{pesos(b.savings+summary.transfers)}</strong></div><div className="notice"><ShieldCheck size={19}/><p>Recording a transfer does not send real money. Move it in your banking app first.</p></div></div></div><div className="panel padded"><div className="panel-heading"><div><h2>Transfer history</h2><p>Where you chose to keep your savings</p></div></div>{state.entries.filter(e=>e.type==='transfer').length?[...state.entries].reverse().filter(e=>e.type==='transfer').map(e=><ActivityItem key={e.id} e={e}/>):<div className="empty-mini"><span>🏦</span><strong>No transfers recorded</strong><p>Your savings will appear here once you record a transfer.</p></div>}</div></>}{tab==='coach'&&<><div className="heading-row"><div><div className="eyebrow">YOUR MONEY SIDEKICK</div><h1>Meet your money coach <span className="wave">✳</span></h1><p className="muted">Friendly guidance based on your own money activity.</p></div></div><div className="coach-layout"><section className="panel coach-panel"><div className="coach-header"><div className="coach-avatar"><Sparkles size={23}/></div><div><strong>Pocketwise Coach</strong><p><span className="online-dot"/> {online?'Online AI when configured · offline backup':'Offline money guidance available'}</p></div></div><div className="chat-log"><div className="chat-row assistant"><div className="bubble">Hey there! 👋 I'm your money buddy. Ask me how to budget your allowance, decide whether something is a need or want, or understand your savings. I can use your local transaction summary to give relevant tips.</div></div>{chat.map((m,i)=><div key={i} className={'chat-row '+m.role}><div className="bubble">{m.text}</div></div>)}{thinking&&<div className="chat-row assistant"><div className="bubble">Thinking…</div></div>}</div><div className="suggestions">{['Can I afford a treat?','Is school fare a need?','How does rollover work?'].map(s=><button key={s} onClick={()=>ask(s)}>{s}</button>)}</div><form className="chat-form" onSubmit={e=>{e.preventDefault();ask(question)}}><input aria-label="Ask your money coach" placeholder="Ask about your money…" value={question} onChange={e=>setQuestion(e.target.value)}/><button aria-label="Send message" disabled={!question.trim()||thinking}><Send size={19}/></button></form></section><aside className="coach-aside"><div className="panel padded"><div className="coach-aside-icon">🔐</div><h3>Your data stays yours</h3><p>Offline advice runs on your device. When cloud AI is enabled, only a limited snapshot of your finance records and your question are sent to the AI provider.</p></div><div className="panel padded"><h3>What the coach knows</h3><p>Current balances, recent transactions, rollover rules, and matching records. It never accesses bank accounts.</p><div className="notice"><HelpCircle size={18}/><p>Educational tips only, not professional financial advice.</p></div></div></aside></div></>}{tab==='settings'&&<><div className="heading-row"><div><div className="eyebrow">MAKE IT YOURS</div><h1>Settings</h1><p className="muted">Your preferences, privacy and data.</p></div></div><div className="settings-wrap"><div className="panel padded"><h2>Money rules</h2><div className="setting-row"><div><strong>Automatically roll over leftovers</strong><p>When your next allowance is on a later date, combine unused Needs + Wants with the new allowance, then split the pool 50/30/20. Savings remain untouched.</p></div><label className="switch"><input type="checkbox" checked={state.settings.rollover} onChange={e=>setState(s=>({...s,settings:{...s.settings,rollover:e.target.checked}}))}/><span/></label></div><div className="setting-row"><div><strong>Dark mode</strong><p>Switch to a comfortable nighttime theme.</p></div><label className="switch"><input type="checkbox" checked={state.settings.theme==='dark'} onChange={e=>setState(s=>({...s,settings:{...s.settings,theme:e.target.checked?'dark':'light'}}))}/><span/></label></div></div><div className="panel padded"><h2>Your data</h2><p className="muted">Everything is stored locally in this browser. Make backups regularly.</p><div className="setting-buttons"><button className="secondary" onClick={exportFile}><Download size={17}/> Export backup</button><label className="secondary file-button"><Upload size={17}/> Restore backup<input type="file" accept="application/json,.json" onChange={e=>{importFile(e.target.files?.[0]);e.target.value=''}}/></label></div><div className="notice"><ShieldCheck size={18}/><p>Clearing browser storage or uninstalling may erase your data. Backups are JSON files, not bank statements.</p></div></div><div className="panel padded"><h2>Install on your phone</h2><p className="muted">Pocketwise works offline after the first successful online load.</p><button className="secondary" onClick={async()=>{if(install){await install.prompt();setInstall(null)}else notify('In Chrome, open the menu and choose Install app or Add to Home screen.')}}><Download size={17}/> Install Pocketwise</button></div><div className="panel padded danger-zone"><h2>Start fresh</h2><p className="muted">Permanently erase local allowances, expenses and transfer records.</p><button className="danger" onClick={()=>{if(window.confirm('Delete ALL local finance data? Export a backup first. This cannot be undone.')){setState({version:1,entries:[],settings:state.settings,createdAt:new Date().toISOString()});notify('Local data cleared')}}}><Trash2 size={16}/> Delete all data</button></div></div></>}</div></main><nav className="bottom-nav">{nav.map(([id,name,Icon])=><button key={id} className={tab===id?'active':''} onClick={()=>setTab(id)}><Icon size={20}/><span>{name==='Overview'?'Home':name==='AI Coach'?'Coach':name}</span></button>)}</nav>{tab==='home'&&<button className="mobile-fab" onClick={()=>setModal('income')} aria-label="Add allowance"><Plus size={25}/></button>}{modal&&<MoneyModal mode={modal} close={()=>setModal('')} submitIncome={submitIncome} submitExpense={submitExpense} submitTransfer={submitTransfer} b={b}/>} {toast&&<div role="status" className="toast"><CheckCircle2 size={18}/>{toast}</div>}</div>}
function ActivityItem({e}){const isIncome=e.type==='income',isTransfer=e.type==='transfer';return <div className="activity-item"><div className={'activity-symbol '+(isIncome?'positive':isTransfer?'purple':'negative')}>{isIncome?<ArrowDownLeft size={19}/>:isTransfer?<Landmark size={18}/>:<ArrowUpRight size={19}/>}</div><div className="activity-text"><strong>{e.label|| (isIncome?'Allowance':isTransfer?'Savings transfer':'Expense')}</strong><span>{e.date} · {isIncome?'Income':isTransfer?e.provider||'Transfer':e.bucket==='needs'?'Needs':'Wants'}{isIncome&&e.rolloverAmount>0?' · incl. rollover':''}</span></div><strong className={'activity-amount '+(isIncome?'positive-text':'')}>{isIncome?'+':'−'}{pesos(e.amount)}</strong></div>}
function MoneyModal({mode,close,submitIncome,submitExpense,submitTransfer,b}){const isIncome=mode==='income',isTransfer=mode==='transfer';const[amount,setAmount]=useState(''),[label,setLabel]=useState(isIncome?'Daily allowance':''),[bucket,setBucket]=useState(['needs','wants'].includes(mode)?mode:'needs'),[provider,setProvider]=useState('GCash'),[note,setNote]=useState(''),[error,setError]=useState('');function handle(e){e.preventDefault();const value=cents(amount);if(!Number.isSafeInteger(value)||value<=0||value>100000000000){setError('Enter a valid amount greater than zero.');return}if(!isIncome&&value>(isTransfer?b.savings:b[bucket])){setError('Not enough balance in this envelope.');return}if(isIncome)submitIncome(value,label.trim());else if(isTransfer)submitTransfer(value,provider,note);else submitExpense(value,bucket,label.trim()||'Expense')}return <div className="modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)close()}}><form className="modal" onSubmit={handle}><div className="modal-head"><div><div className="eyebrow">MONEY MOVE</div><h2>{isIncome?'Add your allowance':isTransfer?'Record savings transfer':'Log an expense'}</h2></div><button type="button" className="icon-button" aria-label="Close" onClick={close}><X size={20}/></button></div><p className="modal-sub">{isIncome?'We’ll automatically split your money into 50% Needs, 30% Wants and 20% Savings.':isTransfer?'Record money you already moved outside this app. No money is actually sent.':'Keep track of where your money goes.'}</p><label className="field-label" htmlFor="amount">Amount (PHP)</label><div className="amount-field"><span>₱</span><input id="amount" autoFocus inputMode="decimal" type="number" min="0.01" step="0.01" placeholder="0.00" value={amount} onChange={e=>{setAmount(e.target.value);setError('')}} required/></div>{isIncome&&amount&&cents(amount)>0&&<div className="preview"><span>Needs {pesos(Math.floor(cents(amount)*.5))}</span><span>Wants {pesos(Math.floor(cents(amount)*.3))}</span><span>Savings {pesos(cents(amount)-Math.floor(cents(amount)*.5)-Math.floor(cents(amount)*.3))}</span></div>}{!isIncome&&!isTransfer&&<><label className="field-label">Spend from</label><div className="choice-grid">{['needs','wants'].map(k=><button type="button" key={k} className={'choice '+(bucket===k?'chosen':'')} onClick={()=>{setBucket(k);setError('')}}><span>{bucketInfo[k].icon} {bucketInfo[k].title}</span><small>{pesos(b[k])} left</small></button>)}</div></>}{isTransfer&&<><label className="field-label" htmlFor="provider">Where did you move it?</label><select id="provider" value={provider} onChange={e=>setProvider(e.target.value)}><option>GCash</option><option>Maya</option><option>Bank account</option><option>Cash savings</option><option>Other e-wallet</option></select><label className="field-label" htmlFor="note">Optional note</label><input id="note" value={note} onChange={e=>setNote(e.target.value)} placeholder="Reference or account nickname" maxLength={80}/><div className="notice"><ShieldCheck size={18}/><p>This records a transfer only. It does not connect to a bank or move funds.</p></div></>}{!isTransfer&&<><label className="field-label" htmlFor="label">{isIncome?'Source':'What was it for?'}</label><input id="label" value={label} onChange={e=>setLabel(e.target.value)} placeholder={isIncome?'Allowance, side job…':'Jeepney fare, lunch…'} maxLength={80}/></>}{error&&<div className="form-error"><AlertCircle size={16}/>{error}</div>}<div className="modal-actions"><button type="button" className="secondary" onClick={close}>Cancel</button><button className="primary" type="submit">{isIncome?'Allocate money':isTransfer?'Record transfer':'Save expense'} <ChevronRight size={17}/></button></div></form></div>}
createRoot(document.getElementById('root')).render(<App/>);
